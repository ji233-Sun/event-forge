# ============================================================================
# EventForge Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# Never commit .env.local to version control.
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string via Supabase Transaction Pooler
# Format: postgresql://user:password@host:port/database
# The transaction pooler port is typically 6543 for Supabase.
DATABASE_URL=postgresql://user:password@your-supabase-instance.pooler.supabase.com:6543/postgres

# ============================================================================
# AUTHENTICATION (BetterAuth)
# ============================================================================
# BetterAuth secret key for session encryption.
# Generate a secure random string (min 32 characters).
BETTER_AUTH_SECRET=your-secure-random-secret-key-here-min-32-chars

# BetterAuth base URL (used for OAuth callbacks and redirects).
# For development: http://localhost:3000
# For production: https://yourdomain.com
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
# SMTP server for sending verification emails, password resets, etc.
# Common providers: Aliyun DynectDM, SendGrid, Mailgun, AWS SES

# SMTP host (e.g., smtpdm.aliyun.com)
SMTP_HOST=smtpdm.aliyun.com

# SMTP port (typically 465 for secure, 587 for TLS)
SMTP_PORT=465

# Enable TLS/SSL encryption
SMTP_SECURE=true

# SMTP username (usually your email or API user)
SMTP_USER=your-smtp-username@example.com

# SMTP password (or API key)
SMTP_PASS=your-smtp-password

# Sender email address (displayed in email "From" field)
EMAIL_FROM="EventForge <noreply@yourdomain.com>"

# ============================================================================
# AI MODELS CONFIGURATION (Alibaba Qwen / DashScope)
# ============================================================================
# API key for Qwen models via DashScope (百炼平台).
# Get yours at: https://dashscope.aliyun.com/api-key
QWEN_API_KEY=sk-your-dashscope-api-key-here

# Model for simple/fast generation (e.g., chat, summaries)
# Options: qwen-turbo, qwen3.5-flash, qwen-long
QWEN_MODEL_SIMPLE=qwen3.5-flash

# Model for medium-complexity tasks (balanced quality/speed)
# Options: qwen-plus, qwen3.5-flash, qwen-long
QWEN_MODEL_MEDIUM=qwen3.5-flash

# Model for complex/hard tasks (best quality, slower)
# Options: qwen-max, qwen-max-longcontext, qwen3.5-plus
QWEN_MODEL_HARD=qwen3.5-plus

# Model for image generation
# Options: wanx2.6-t2i-turbo, wanx2.6-t2i, qwen-image-2.0
QWEN_MODEL_IMAGE=qwen-image-2.0

# ============================================================================
# AI MODELS CONFIGURATION (MiniMax for Code Generation)
# ============================================================================
# MiniMax API key for code generation tasks.
# Used for fixing broken code and generating embeddings.
# Get yours at: https://www.minimaxi.com/
MINIMAX_API_KEY=sk-api-your-minimax-key

# MiniMax model for code generation
MINIMAX_MODEL_CODE=MiniMax-M2.7

# ============================================================================
# CLOUD STORAGE CONFIGURATION (Cloudflare R2)
# ============================================================================
# R2 is Cloudflare's S3-compatible object storage.
# Sign up at: https://www.cloudflare.com/products/r2/

# Your Cloudflare Account ID (found in R2 settings)
R2_ACCOUNT_ID=your-account-id

# R2 bucket name (for storing images, audio, slides, media)
R2_BUCKET_NAME=event-forge

# R2 Access Key ID (create in R2 API Tokens section)
R2_ACCESS_KEY_ID=your-access-key-id

# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=your-secret-access-key

# ============================================================================
# END OF ENVIRONMENT VARIABLES
# ============================================================================
